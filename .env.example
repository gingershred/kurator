# kurator – Beispielkonfiguration. Kopieren nach `.env` und anpassen.
# Umgebungsvariablen enthalten nur Infrastruktur und Startwerte; alles, was im Betrieb
# geändert wird, liegt in der Datenbank und ist in der Oberfläche einstellbar.
#
# WICHTIG: kurator nur im Heimnetz oder per VPN betreiben, niemals öffentlich ins Internet stellen.

# --- Basis ---------------------------------------------------------------------------------
# Pflicht: zufälliger, geheimer Schlüssel für die Session-Signatur (mind. 16 Zeichen).
# Erzeugen z. B. mit:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KURATOR_SECRET_KEY=
# Adresse, unter der kurator im Netz erreichbar ist (wird u. a. für OIDC-Redirects genutzt).
KURATOR_BASE_URL=http://kurator.lan:8080
KURATOR_TIMEZONE=Europe/Berlin
KURATOR_LANGUAGE=de
# Datenverzeichnis im Container (Datenbank, Backups, Modelle, Downloads). Nicht ändern,
# wenn du docker-compose.yml unverändert nutzt.
KURATOR_DATA_DIR=/data
# true, wenn kurator per HTTPS erreichbar ist (z. B. hinter einem Reverse Proxy im LAN).
KURATOR_SECURE_COOKIES=false
# DEBUG | INFO | WARNING | ERROR
KURATOR_LOG_LEVEL=INFO

# --- Erster Admin --------------------------------------------------------------------------
# Wird nur angelegt, wenn noch kein Nutzer existiert. Passwort nach dem ersten Start entfernen.
KURATOR_ADMIN_USERNAME=admin
KURATOR_ADMIN_PASSWORD=

# --- Login ---------------------------------------------------------------------------------
# local = Benutzername + Passwort, oidc = nur OIDC, both = beides
KURATOR_AUTH_MODE=local
# Nur für oidc/both. Redirect-URI beim Identity Provider: <KURATOR_BASE_URL>/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Claim, der beim ersten OIDC-Login mit dem kurator-Benutzernamen abgeglichen wird.
OIDC_USERNAME_CLAIM=preferred_username

# --- YouTube -------------------------------------------------------------------------------
# Optional, aber empfohlen. Ohne Schlüssel werden nur RSS-Daten genutzt.
YOUTUBE_API_KEY=
# Tagesbudget aller Nutzer zusammen (YouTube erlaubt 10.000 Einheiten/Tag).
QUOTA_DAILY_BUDGET=8000
# Davon höchstens für search.list (Entdecken-Modul).
QUOTA_SEARCH_BUDGET=2000
FEED_POLL_MINUTES=30
# Videos bis zu dieser Länge (Sekunden) gelten als Shorts und werden nie angezeigt.
SHORTS_MAX_SECONDS=180

# --- Downloads (Startwerte, im Admin-Bereich änderbar) --------------------------------------
DOWNLOADS_ENABLED=false
DOWNLOAD_MAX_QUALITY=1080
DOWNLOAD_MAX_STORAGE_GB=50
# Tage nach "gesehen" durch alle Anfordernden, bis eine Datei gelöscht wird.
DOWNLOAD_RETENTION_DAYS=14

# --- LLM (optional) ------------------------------------------------------------------------
LLM_ENABLED=false
# z. B. https://openrouter.ai/api/v1 oder http://ollama:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings ----------------------------------------------------------------------------
# local | openai_compatible
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
